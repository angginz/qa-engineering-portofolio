            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employee_id\": \"EMP001\",\n  \"date\": \"2026-10-02\",\n  \"start_time\": \"18:00\",\n  \"end_time\": \"20:00\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/overtime",
