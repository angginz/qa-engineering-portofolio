            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employee_id\": \"EMP001\",\n  \"check_in_time\": \"2026-10-01T08:00:00+07:00\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/attendance/check-in",
